@using Microsoft.AspNetCore.Http
@{
    var currentUser = Context.Session.GetString("AuthenticatedUser");
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LoginDemo</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="container topbar__content">
            <a asp-controller="Home" asp-action="Index" class="brand-link">LoginDemo</a>
            <div class="topbar-actions">
                @if (!string.IsNullOrWhiteSpace(currentUser))
                {
                    <a asp-controller="Home" asp-action="Dashboard" class="topbar-link">Dashboard</a>
                    <span class="subtitle">目前登入：@currentUser</span>
                }
                else
                {
                    <span class="subtitle">.NET 10 MVC 多登入方式示範</span>
                }
            </div>
        </div>
    </header>

    <main class="container page-content">
        @RenderBody()
    </main>
</body>
</html>
