@model LoginOptionsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="auth-shell">
    <div class="auth-panel auth-panel--intro">
        <p class="eyebrow">Login Demo</p>
        <h1>@Model.Title</h1>
        <p class="hero-text">@Model.Description</p>

        <div class="usage-box">
            <h2>登入流程</h2>
            <p>1. 先從首頁選擇登入方式。</p>
            <p>2. AD 登入會直接模擬成功。</p>
            <p>3. 一般帳號密碼登入會切換到另一個畫面輸入帳密。</p>
        </div>
    </div>

    <div class="auth-panel">
        @if (TempData["LoginMessage"] is string loginMessage)
        {
            <div class="status-message" role="status">
                @loginMessage
            </div>
        }

        <div class="login-grid">
            @foreach (var method in Model.Methods)
            {
                <article class="login-option">
                    <div>
                        <h2>@method.Title</h2>
                        <p>@method.Description</p>
                    </div>

                    @if (method.IsPost)
                    {
                        <form asp-action="@method.ActionName" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="login-button">@method.SubmitLabel</button>
                        </form>
                    }
                    else
                    {
                        <a asp-action="@method.ActionName" class="login-link">@method.SubmitLabel</a>
                    }
                </article>
            }
        </div>
    </div>
</section>
