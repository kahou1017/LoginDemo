@model LoginViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="auth-shell auth-shell--single">
    <div class="auth-panel auth-panel--intro">
        <p class="eyebrow">Password Login</p>
        <h1>@Model.Title</h1>
        <p class="hero-text">
            請輸入帳號與密碼完成登入。這一版先保留展示用固定帳密，登入成功後會導向 Dashboard。
        </p>

        <div class="usage-box">
            <h2>測試帳號</h2>
            <p class="auth-hint">@Model.HintMessage</p>
            <div class="credential-chip-group">
                <span class="credential-chip">帳號: demo</span>
                <span class="credential-chip">密碼: 1234</span>
            </div>
        </div>

        <a asp-action="Index" class="back-link">返回登入方式選擇</a>
    </div>

    <div class="auth-panel">
        @if (TempData["LoginMessage"] is string loginMessage)
        {
            <div class="status-message" role="status">
                @loginMessage
            </div>
        }

        <form asp-action="PasswordLogin" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-message" role="alert"></div>

            <div class="form-field">
                <label asp-for="Username"></label>
                <input asp-for="Username" class="text-input" autocomplete="username" />
                <span asp-validation-for="Username" class="field-validation"></span>
            </div>

            <div class="form-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="text-input" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation"></span>
            </div>

            <button type="submit" class="login-button">登入</button>
        </form>
    </div>
</section>
